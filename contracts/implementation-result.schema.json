{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/implementation-result.schema.json",
  "title": "ImplementationResult",
  "description": "implement.* 노드의 출력 계약. 완료 단언 규칙(COMPLETION-RULE §1~4)을 기계적으로 강제한다 — 검증 아티팩트 없이는 status가 done이 될 수 없다.",
  "type": "object",
  "required": ["status", "branch", "tdd", "verification", "summary_md"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["done", "in-progress", "blocked"],
      "description": "verification.exit_code가 0이 아니거나 아티팩트가 비면 done을 쓸 수 없다."
    },
    "branch": { "type": "string", "minLength": 1 },
    "worktree": { "type": "string", "description": "격리 worktree 경로. 메인 worktree 작업은 core-directives §5 위반." },
    "tdd": {
      "type": "object",
      "description": "RED가 GREEN보다 먼저 있었다는 증거. 순서를 못 대면 TDD 위반이다.",
      "required": ["red_first", "test_files"],
      "additionalProperties": false,
      "properties": {
        "red_first": { "type": "boolean" },
        "red_evidence": { "type": "string", "description": "실패 확인 출력 또는 커밋 해시" },
        "test_files": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "verification": {
      "type": "object",
      "description": "실제 실행 증거. exit code로 판정한다 — 파이프 뒤 tail 금지.",
      "required": ["command", "exit_code", "artifact_path"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "artifact_path": { "type": "string", "minLength": 1, "description": "runs/<run-id>/<node>/ 아래 raw 출력 경로" },
        "executed": { "type": "boolean", "description": "false면 exec_shell 부재로 미실행 — status는 in-progress여야 한다" }
      }
    },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "summary_md": { "type": "string", "minLength": 1 },
    "degraded": {
      "type": "object",
      "properties": { "reason": { "type": "string" }, "path": { "type": "string" } }
    }
  }
}
