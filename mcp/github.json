{
  "_service": "GitHub",
  "_status": "needs-setup",
  "_note": "~/.claude.json에 추가 필요. GITHUB_TOKEN은 ~/.zshrc에서 로드.",
  "_package": "@modelcontextprotocol/server-github",
  "_install": "npm install -g @modelcontextprotocol/server-github",

  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },

  "_envVars": {
    "GITHUB_TOKEN": "https://github.com/settings/tokens 에서 발급 (repo, read:org, read:user 스코프)"
  },

  "_provides": [
    "get_file_contents",
    "search_code",
    "list_issues",
    "create_issue",
    "create_pull_request",
    "get_pull_request",
    "list_pull_requests",
    "merge_pull_request",
    "search_repositories",
    "list_commits",
    "get_commit",
    "create_review",
    "add_pull_request_review_comment"
  ]
}
