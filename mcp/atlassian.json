{
  "_service": "Jira + Confluence",
  "_status": "active",
  "_note": "~/.claude.json에 이미 등록됨. 아래는 참조용 레퍼런스.",
  "_package": "mcp-atlassian (npm global)",
  "_install": "npm install -g mcp-atlassian",

  "mcpServers": {
    "atlassian-doodlin": {
      "command": "~/.nvm/versions/node/v22.15.0/bin/mcp-atlassian",
      "env": {
        "ATLASSIAN_BASE_URL": "https://doodlin.atlassian.net",
        "ATLASSIAN_EMAIL": "biuea@doodlin.co.kr",
        "ATLASSIAN_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "READ_ONLY": "true"
      }
    }
  },

  "_envVars": {
    "ATLASSIAN_API_TOKEN": "https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급"
  },

  "_provides": [
    "read_jira_issue",
    "search_jira_issues",
    "create_jira_issue",
    "add_jira_comment",
    "read_confluence_page",
    "search_confluence_pages",
    "create_confluence_page",
    "update_confluence_page"
  ]
}
