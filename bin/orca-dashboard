<details id="no-terminal"><summary id="no-terminal-title">터미널 없는 worktree</summary><ul id="no-terminal-list"></ul></details>
<script>
"use strict";
const STATUS_LABEL = {blocked: "막힘", waiting_user: "사용자 대기", stale: "정체",
  running: "실행 중", background: "백그라운드", idle: "유휴"};
let latest = null;
let pollMs = 3000;
let fetchError = null;

function el(tag, className, text) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined && text !== null) node.textContent = String(text);
  return node;
}

function ago(ms) {
  if (ms === null || ms === undefined) return "-";
  const seconds = Math.max(0, Math.floor((Date.now() - ms) / 1000));
  if (seconds < 60) return seconds + "초 전";
  if (seconds < 3600) return Math.floor(seconds / 60) + "분 전";
  return Math.floor(seconds / 3600) + "시간 " + Math.floor((seconds % 3600) / 60) + "분 전";
}

function clock(ms) {
  return new Date(ms).toLocaleTimeString("ko-KR", {hour12: false});
}

function prText(pr) {
  return pr ? "PR #" + pr.number + " (" + pr.state + ")" : null;
}

function card(session) {
  const node = el("article", "card " + session.status);
  const head = el("div", "card-head");
  head.appendChild(el("div", "name", session.name || "(이름 없음)"));
  head.appendChild(el("span", "badge " + session.status, STATUS_LABEL[session.status] || session.status));
  node.appendChild(head);
  node.appendChild(el("div", "meta", [session.repo || "-", session.branch].join(" · ")));
  const agentLine = ["agent " + (session.agentState || "-")];
  if (session.mainState) agentLine.push("main " + session.mainState);
  if (session.agentType) agentLine.push(session.agentType);
  if (session.toolName) agentLine.push("도구 " + session.toolName);
  if (session.kind === "terminal") agentLine.push("터미널 판정");
  node.appendChild(el("div", "meta", agentLine.join(" · ")));
  node.appendChild(el("div", "row reason", session.reason));
  if (session.summary && session.summary.text) {
    node.appendChild(el("div", "row summary", session.summary.text));
  }
  const progress = el("div", "progress");
  if (session.progress && session.progress.percent !== null) {
    const bar = el("div", "bar");
    bar.setAttribute("role", "progressbar");
    bar.setAttribute("aria-valuenow", String(session.progress.percent));
    bar.setAttribute("aria-valuemin", "0");
    bar.setAttribute("aria-valuemax", "100");
    const fill = el("span");
    fill.style.width = Math.min(100, Math.max(0, session.progress.percent)) + "%";
    bar.appendChild(fill);
    progress.appendChild(bar);
    progress.appendChild(el("div", "meta", session.progress.percent + "% — " + session.progress.basis));
  } else {
    progress.appendChild(el("div", "meta", "진행률 산정 불가" +
      (session.progress && session.progress.basis !== "산정 불가" ? " — " + session.progress.basis : "")));
  }
  node.appendChild(progress);
  const footer = [];
  const output = el("span", "ago");
  output.dataset.ms = session.lastOutputAt === null ? "" : String(session.lastOutputAt);
  output.textContent = "마지막 출력 " + ago(session.lastOutputAt);
  const meta = el("div", "row meta");
  meta.appendChild(output);
  if (prText(session.pr)) footer.push(prText(session.pr));
  if (session.comment) footer.push("코멘트: " + session.comment);
  if (footer.length) meta.appendChild(el("span", null, " · " + footer.join(" · ")));
  node.appendChild(meta);
  return node;
}

function renderWorktrees(listId, titleId, label, items) {
  const list = document.getElementById(listId);
  list.replaceChildren();
  document.getElementById(titleId).textContent = label + " (" + items.length + ")";
  for (const item of items) {
    const parts = [item.repo || "-", item.branch, item.displayName];
    if (item.liveTerminalCount) parts.push("터미널 " + item.liveTerminalCount + "개");
    if (prText(item.pr)) parts.push(prText(item.pr));
    list.appendChild(el("li", null, parts.filter(Boolean).join(" · ")));
  }
}

function renderBanner() {
  const banner = document.getElementById("banner");
  const messages = [];
  if (fetchError) messages.push("대시보드 서버 연결 실패: " + fetchError);
  if (latest && latest.error) {
    const since = latest.lastSuccessAt ? " — 직전 성공 " + clock(latest.lastSuccessAt) +
      " (" + ago(latest.lastSuccessAt) + ") 데이터 표시 중" : " — 성공한 수집 없음";
    messages.push("Orca 수집 실패: " + latest.error + since);
  }
  banner.textContent = messages.join("\n");
  banner.classList.toggle("show", messages.length > 0);
}

function render() {
  if (!latest) return;
  document.getElementById("kpi-total").textContent = latest.kpi.total;
  document.getElementById("kpi-running").textContent = latest.kpi.running;
  document.getElementById("kpi-waiting").textContent = latest.kpi.waitingUser;
  document.getElementById("kpi-blocked").textContent = latest.kpi.blockedOrStale;
  const cards = document.getElementById("cards");
  cards.replaceChildren(...latest.sessions.map(card));
  if (!latest.sessions.length) cards.appendChild(el("div", "empty", "표시할 에이전트 세션이 없습니다"));
  renderWorktrees("shell-only-list", "shell-only-title", "셸만 열린 worktree", latest.shellOnly || []);
  renderWorktrees("no-terminal-list", "no-terminal-title", "터미널 없는 worktree", latest.noTerminal || []);
  renderBanner();
  tick();
}

function tick() {
  if (latest) {
    const base = latest.lastSuccessAt || latest.generatedAt;
    document.getElementById("updated").textContent = "갱신 " + ago(base);
  }
  for (const node of document.querySelectorAll(".ago")) {
    node.textContent = "마지막 출력 " + (node.dataset.ms ? ago(Number(node.dataset.ms)) : "-");
  }
}

async function poll() {
  try {
    const response = await fetch("/api/snapshot", {cache: "no-store"});
    if (!response.ok) throw new Error("HTTP " + response.status);
    latest = await response.json();
    fetchError = null;
    if (latest.interval) pollMs = Math.max(500, latest.interval * 1000);
    render();
  } catch (error) {
    fetchError = String(error && error.message ? error.message : error);
    renderBanner();
  } finally {
    setTimeout(poll, pollMs);
  }
}

setInterval(tick, 1000);
poll();
</script>
</body>
</html>
"""


if __name__ == "__main__":
    sys.exit(main())
