<div id="banner" class="banner" role="alert"></div>
<section class="kpis" aria-label="요약">
  <div class="kpi"><div class="muted">전체</div><div class="value" id="kpi-total">-</div></div>
  <div class="kpi"><div class="muted">실행 중</div><div class="value" id="kpi-running">-</div></div>
  <div class="kpi"><div class="muted">사용자 대기</div><div class="value" id="kpi-waiting">-</div></div>
  <div class="kpi"><div class="muted">막힘/정체</div><div class="value" id="kpi-blocked">-</div></div>
